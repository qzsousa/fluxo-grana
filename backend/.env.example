# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/finance?schema=public"

# Auth
JWT_SECRET=your-super-secret-key-for-jwt-token-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (optional - for password reset, etc.)
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM="Finance App <noreply@yourdomain.com>"